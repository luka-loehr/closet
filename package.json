{
  "name": "closet",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild client/app.ts --bundle --minify --format=iife --target=es2022 --outfile=public/app.js",
    "build": "npm run build:client",
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply closet --local",
    "migrate": "wrangler d1 migrations apply closet --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.129.0"
  }
}